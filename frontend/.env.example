# Wind Forecast Intelligence Frontend Environment Configuration

# Backend API base URL
# - Local Vite dev: Leave empty (Vite dev server proxies /api to http://localhost:8000)
# - Local Docker Compose: Leave empty (Nginx container reverse-proxies /api to http://backend:8000)
# - Production on Vercel (Method A - Direct CORS): Set to your deployed backend URL:
#     VITE_API_BASE_URL=https://wind-forecast-backend.onrender.com
# - Production on Vercel (Method B - Edge Rewrites): Leave empty and set destination in vercel.json
VITE_API_BASE_URL=

