# ==============================================================================
# Wind Forecast Intelligence — Backend Dockerfile for Vercel Container Runtime
# Python 3.12 / FastAPI / Uvicorn
# ==============================================================================

FROM python:3.12-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Install ca-certificates for verified TLS connections to the Elexon API
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create a non-privileged user and group for security
RUN groupadd -g 1000 appgroup && \
    useradd -u 1000 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Copy dependency specifications first to leverage Docker layer cache
COPY requirements.txt .

# Upgrade pip and install production dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY app/ ./app/

# Set ownership of application files to non-privileged user
RUN chown -R appuser:appgroup /app

# Switch to non-privileged user
USER appuser

# Expose default HTTP port 80 for Vercel container routing
EXPOSE 80

# Start Uvicorn ASGI server bound to 0.0.0.0.
# Vercel container functions receive traffic on port 80 by default unless $PORT is configured.
# 'exec' ensures Uvicorn runs as PID 1 to handle SIGTERM/SIGINT signals gracefully.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
