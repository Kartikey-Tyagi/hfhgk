# Wind Forecast Intelligence Backend Configuration

# Listening port for Uvicorn (assigned dynamically by PaaS providers like Render/Heroku; defaults to 8000 locally)
PORT=8000

# Official Elexon Insights Solution (BMRS) API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Request timeout in seconds for Elexon API calls
ELEXON_REQUEST_TIMEOUT=30.0

# Default day-ahead purchasing decision cutoff (UTC on D-1)
DEFAULT_CUTOFF_TIME=12:00:00

# Allowed CORS origins (comma-separated list, whitespace-trimmed)
# Local defaults include: http://localhost:5173,http://localhost:8080
# In production, add your deployed Vercel domain:
# CORS_ORIGINS=https://wind-forecast-intelligence.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

