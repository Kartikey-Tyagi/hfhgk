# ==============================================================================
# Wind Forecast Intelligence — Docker Compose & Deployment Environment Config
# Copy this file to .env before running docker compose if you need custom settings:
#   cp .env.example .env
# All variables have safe defaults and can be omitted for local execution.
# ==============================================================================

# Official Elexon Insights Solution (BMRS) API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Request timeout in seconds for Elexon API calls
ELEXON_REQUEST_TIMEOUT=30.0

# Provisional default day-ahead purchasing decision cutoff time (UTC on D-1)
DEFAULT_CUTOFF_TIME=12:00:00

# Backend service port (defaults to 8000; dynamically assigned on Heroku/Render)
PORT=8000

# Allowed CORS origins for backend (comma-separated list, whitespace-trimmed)
# For production deployments, include your deployed Vercel domain:
# CORS_ORIGINS=https://wind-forecast-intelligence.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

